{
  "name": "stylecam-workbench",
  "version": "0.1.0",
  "private": true,
  "description": "EasyInput 第六课 StyleCam 创作工作台",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.mjs",
    "icon:build": "node scripts/build-icon.mjs",
    "package:win": "npm run icon:build && electron-builder --win --dir"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.5"
  },
  "build": {
    "appId": "dev.easyinput.stylecam-workbench",
    "productName": "StyleCam 创作工作台",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "assets/**/*",
      "index.html",
      "package.json"
    ],
    "win": {
      "icon": "assets/icon/stylecam.ico",
      "signAndEditExecutable": true
    }
  }
}
